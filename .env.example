# Copy to .env (git-ignored) and fill in your own value.

# Used by system/ig-carousel/generate-backgrounds.ts to generate AI
# illustration backgrounds for the "Atlas Ilustrado" carousel style
# (see .claude/skills/carousel-designer/references/style-library.md).
# The sibling city-activities-api repo already has a working key under
# the same env var name if you need to reuse one instead of creating new.
OPENAI_API_KEY=sk-your-api-key-here
