.claude/settings.local.json
.DS_Store

# Profiles are private by default — only allow-listed profiles are tracked.
# Git won't apply file-level exceptions inside an ignored directory, so any
# real profile that wants to track its content needs its directory
# un-ignored too, with config.local.yaml itself re-ignored underneath (the
# .example counterpart stays tracked as the onboarding template, same
# convention as profiles/example/config.local.yaml.example).
profiles/*
!profiles/example/
!profiles/adondepo/
profiles/adondepo/config.local.yaml

# Node / IG carousel generator (system/ig-carousel)
node_modules/
dist/
system/ig-carousel/output/
system/ig-carousel/week-input.json

# Secrets — never commit real API keys
.env
.env.local

# AI-generated carousel background images (reproducible via
# generate-backgrounds.ts, but cost real money per image to regenerate —
# excluded from git purely for repo size, not because they're disposable)
system/ig-carousel/backgrounds/

# Rendered carousel output (reproducible via render-week.ts/render-brand.ts)
profiles/adondepo/outputs/

# Comparison/experiment artifacts — not part of the shipped system
compare-canvas-design/
preview-brand-carousel*.html
