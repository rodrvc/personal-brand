      "footerLocation": "{city}, {region}",
      "footerCta": "Find more at",
      "timeSuffix": "",
      "categoryFallbackLabel": "Event"
    },
    "brandMessage": {
      "footerCta": "Find more at"
    },
    "reel": {
      "coverTitle": "What's on",
      "coverSubtitle": "in {city}",
      "coverCount": "{count} picks this week",
      "closingCta": "Find more at"
    }
  },

  "dates": {
    "monthAbbr": [
      "Jan", "Feb", "Mar", "Apr", "May", "Jun",
      "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    ],
    "weekRangeSameMonth": "{startMonth} {startDay}–{endDay}",
    "weekRangeCrossMonth": "{startMonth} {startDay} – {endMonth} {endDay}"
  }
