{
  "_source": "Placeholder brand for the example profile. Deliberately unlike any real profile — different palette, English category taxonomy, system fonts and NO googleFontsHref — so that rendering with it proves the engine carries no brand assumptions of its own. Copy this file when onboarding a new profile and replace every value.",

  "locale": "en-US",

  "colors": {
    "ink": "#14213d",
    "signal": "#fca311",
    "slate": "#3d405b",
    "mist": "#8d99ae",
    "paper": "#ffffff",
    "sky": "#4361ee"
  },

  "roles": {
    "accent": "signal",
    "wordmark": "ink",
    "surface": "paper",
    "onSurface": "slate",
    "onSurfaceMuted": "mist",
    "flourish": "sky",
    "highlight": "signal"
  },

  "fonts": {
    "logo": "Georgia, serif",
    "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "handwritten": "Georgia, serif"
  },

  "radius": { "card": "8px" },
  "gradients": {
    "signalSky": "linear-gradient(135deg, #fca311, #4361ee)",
    "cover": "linear-gradient(180deg, #4361ee, #14213d)"
  },

  "categories": {
    "fallback": { "solid": "#8d99ae" },
